{
  "name": "guess-number-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @guess-number/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest",
    "test:launcher": "node --test scripts/start-game.test.mjs",
    "test:e2e": "npm run test:e2e --workspace @guess-number/web --if-present"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
